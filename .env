# Copy to enterprise_rag/.env and fill in. .env is gitignored — never commit real keys.
# Anything set in the real environment (systemd, your shell) wins over this file.

# --- Operator secrets -----------------------------------------------------
# Required to create/list tenants via the API. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENTERPRISE_ADMIN_API_KEY=VPrPd2DQWFg2_rPRtLFIM3RsGFabBqdkYXK-W3mOFas

# Encrypts tenant provider keys at rest (Fernet, via the cryptography package).
# Without it keys are stored in plain files with mode 0600 — fine for a laptop,
# not for production. Changing it later means re-collecting every tenant's key.
ENTERPRISE_SECRET_KEY=8kvdEWdMhIKvwE9NvVaqfjOmR5FcpX9REHFP-IHqX38=

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Comma separated. Required once DEBUG=False.
DJANGO_ALLOWED_HOSTS=
# Needed for the chat page over HTTPS behind a proxy, e.g. https://rag.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Sites allowed to call /api/v1/ask/ from a browser (tenant widget embeds).
CORS_ALLOWED_ORIGINS=

# --- Engine ---------------------------------------------------------------
# One embedding model shared by every tenant; per-tenant models are for chat only.
ENTERPRISE_EMBEDDING_MODEL=all-MiniLM-L6-v2
ENTERPRISE_TOP_K=4
ENTERPRISE_MAX_TOKENS=1024

# Conversation memory. Empty keeps history in process memory, which is fine for
# `manage.py runserver` and WRONG under gunicorn — its workers are separate
# processes, so follow-ups would land on a worker that has never seen the
# conversation. Set a shared SQLite path in production.
# ENTERPRISE_HISTORY_DB=/home/YOUR_USER/GenAI-Course/enterprise_rag/var/history.sqlite3
ENTERPRISE_HISTORY_TURNS=6

# Where tenant data lives (documents, indexes, encrypted keys). Defaults to
# enterprise_rag/var/.
# ENTERPRISE_VAR_DIR=

# --- Vector database --------------------------------------------------------
# "faiss" (default) keeps vectors in files under each tenant's directory --
# nothing extra to run. "qdrant" keeps them in one Qdrant collection per
# tenant; start a local server first:
#   docker run -d --name qdrant -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant
# Switching backends does not migrate vectors -- reindex each tenant after
# (console -> client -> Upload & reindex, or `python -m ragengine --tenant <slug> build-index`).
ENTERPRISE_VECTOR_BACKEND=qdrant
# ENTERPRISE_QDRANT_URL=http://127.0.0.1:6333
# Only needed for Qdrant Cloud:
# ENTERPRISE_QDRANT_API_KEY=

# NOTE: there is no ANTHROPIC_API_KEY or GOOGLE_API_KEY here on purpose —
# every tenant brings their own provider key at onboarding time.
